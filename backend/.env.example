# =====================================================
# 로컬 개발용 환경변수
# Railway 배포 시에는 Railway 대시보드에서 직접 설정
# =====================================================

# --- Database (로컬) ---
DATABASE_URL=postgresql+psycopg2://careermatch:careermatch@localhost:5432/careermatch
# Railway는 PostgreSQL 플러그인 추가 시 DATABASE_URL을 자동 주입

# --- OpenAI (선택) ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- CORS (배포 시 Vercel 주소로 교체) ---
CORS_ORIGINS_STR=["http://localhost:5173","http://127.0.0.1:5173"]
# 배포 후: ["https://여기에vercel주소.vercel.app","http://localhost:5173"]

# --- Q-Net (기본값 사용, 수정 불필요) ---
# QNET_API_KEY_DECODED=...

# --- Runtime ---
LOG_LEVEL=INFO
ENVIRONMENT=production
